{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "color": {
            "palette": [
                {
                    "slug": "base",
                    "color": "#DFDFDF",
                    "name": "Base"
                },
                {
                    "slug": "base-2",
                    "color": "#CDCDCD",
                    "name": "Base 2"
                },
                {
                    "slug": "contrast-1",
                    "color": "#171717",
                    "name": "Contrast 1"
                },
                {
                    "slug": "contrast-2",
                    "color": "#FFFFFF",
                    "name": "Contrast 2"
                },
                {
                    "slug": "accent",
                    "color": "#FDCA78",
                    "name": "Accent"
                }
            ]
        },
        "typography": {
            "fontFamilies": [
                {
                    "slug": "poppins",
                    "name": "Poppins",
                    "fontFamily": "Poppins, sans-serif",
                    "fontFace": [
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "100",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/Poppins-Thin.ttf"
                            ]
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "100",
                            "fontStyle": "italic",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/Poppins-ThinItalic.ttf"
                            ]
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "200",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/Poppins-ExtraLight.ttf"
                            ]
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "200",
                            "fontStyle": "italic",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/Poppins-ExtraLightItalic.ttf"
                            ]
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "300",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/Poppins-Light.ttf"
                            ]
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "300",
                            "fontStyle": "italic",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/Poppins-LightItalic.ttf"
                            ]
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "400",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/Poppins-Regular.ttf"
                            ]
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "400",
                            "fontStyle": "italic",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/Poppins-Italic.ttf"
                            ]
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "500",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/Poppins-Medium.ttf"
                            ]
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "600",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/Poppins-SemiBold.ttf"
                            ]
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "700",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/Poppins-Bold.ttf"
                            ]
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "800",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/Poppins-ExtraBold.ttf"
                            ]
                        },
                        {
                            "fontFamily": "Poppins",
                            "fontWeight": "900",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/Poppins-Black.ttf"
                            ]
                        }
                    ]
                },
                {
                    "slug": "biko",
                    "name": "Biko",
                    "fontFamily": "Biko, sans-serif",
                    "fontFace": [
                        {
                            "fontFamily": "Biko",
                            "fontWeight": "800",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/Biko_Black.otf"
                            ]
                        },
                        {
                            "fontFamily": "Biko",
                            "fontWeight": "200",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/Biko_Light-Restricted.otf"
                            ]
                        },
                        {
                            "fontFamily": "Biko",
                            "fontWeight": "400",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/Biko_Regular.otf"
                            ]
                        },
                        {
                            "fontFamily": "Biko",
                            "fontWeight": "700",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/Biko_Bold.otf"
                            ]
                        }
                    ]
                }
            ],
            "fontSizes": [
                {
                    "slug": "small",
                    "size": "0.875rem",
                    "name": "Small"
                },
                {
                    "slug": "medium",
                    "size": "1rem",
                    "name": "Medium"
                },
                {
                    "slug": "large",
                    "size": "1.25rem",
                    "name": "Large"
                },
                {
                    "slug": "x-large",
                    "size": "1.75rem",
                    "name": "X Large"
                },
                {
                    "slug": "xx-large",
                    "size": "2.5rem",
                    "name": "XX Large"
                },
                {
                    "slug": "huge",
                    "size": "4rem",
                    "name": "Huge"
                }
            ]
        },
        "layout": {
            "contentSize": "960px",
            "wideSize": "1440px"
        },
        "spacing": {
            "spacingScale": {
                "operator": "*",
                "increment": 1.5,
                "steps": 7,
                "mediumStep": 1.5,
                "unit": "rem"
            }
        }
    },
    "styles": {
        "color": {
            "background": "#DFDFDF",
            "text": "#171717"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--poppins)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.6"
        },
        "spacing": {
            "blockGap": "2rem"
        },
        "elements": {
            "h1": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--biko)",
                    "fontSize": "var(--wp--preset--font-size--huge)",
                    "fontWeight": "700",
                    "lineHeight": "1.1",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.02em"
                }
            },
            "h2": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--poppins)",
                    "fontSize": "var(--wp--preset--font-size--xx-large)",
                    "fontWeight": "400",
                    "lineHeight": "1.2"
                }
            },
            "h3": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--poppins)",
                    "fontSize": "var(--wp--preset--font-size--x-large)",
                    "fontWeight": "400",
                    "lineHeight": "1.3"
                }
            },
            "h4": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--poppins)",
                    "fontSize": "var(--wp--preset--font-size--large)",
                    "fontWeight": "400"
                }
            },
            "link": {
                "color": {
                    "text": "#171717"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--poppins)",
                    "textDecoration": "none"
                }
            },
            "button": {
                "color": {
                    "background": "#FDCA78",
                    "text": "#171717"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--poppins)",
                    "fontSize": "var(--wp--preset--font-size--medium)",
                    "fontWeight": "400",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.08em"
                },
                "spacing": {
                    "padding": {
                        "top": "0.75rem",
                        "bottom": "0.75rem",
                        "left": "2rem",
                        "right": "2rem"
                    }
                },
                "border": {
                    "radius": "0px"
                }
            }
        }
    }
}